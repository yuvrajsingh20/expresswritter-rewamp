generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUB_ADMIN
  FREELANCER
  STUDENT
}

enum ProjectStatus {
  CREATED
  ASSIGNED
  IN_PROGRESS
  REVIEW
  QUALITY_CHECK
  UNDER_REVIEW
  REVISION
  COMPLETED
}

enum ChatType {
  CLIENT_CHAT
  INTERNAL_CHAT
  ADMIN_CHAT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id String @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(STUDENT)
  permissions   String[]  @default([])
  
  // Profile Fields
  phone            String?
  occupation       String?   // e.g. Student, Freelancer, Professional
  college          String?
  profileCompleted Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  
  projectsOwned    Project[] @relation("StudentProjects")
  projectsAssigned Project[] @relation("FreelancerProjects")
  projectsManaged  Project[] @relation("SubAdminProjects")
  
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  freelancerInvoices FreelancerInvoice[] @relation("FreelancerInvoices")
  collaboratingProjects Project[] @relation("CollaboratingProjects")
  studentChats     Chat[]    @relation("StudentChats")
  freelancerChats  Chat[]    @relation("FreelancerChats")
  
  notifications    Notification[]
  orders           Order[]
  projectLogs      ProjectLog[]
  freelancerProfile FreelancerProfile?
  payoutRequests    PayoutRequest[]
  clientTickets    Ticket[] @relation("ClientTickets")
  writerTickets    Ticket[] @relation("WriterTickets")

  @@index([role])
}

model FreelancerProfile {
  id String @id @default(uuid())
  userId        String   @unique 
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bio           String?
  skills        String[] // E.g. ["SOP", "LOR", "Technical", "Academic"]
  experience    Int?     // Years of experience
  education     String?  // Highest qualification
  resumeUrl     String?  // Link to resume
  age           Int?
  gender        String?
  linkedinUrl   String?
  photoUrl      String?  // Profile photo
  portfolioUrl  String?
  portfolioFiles String? // JSON string of uploaded portfolio files
  rating        Float    @default(5.0)
  totalProjects Int      @default(0)
  isVerified    Boolean  @default(false)
  availability  Boolean  @default(true)
  status        String   @default("Pending Approval")
  rejectionReason String?
  writerLevel   String   @default("JUNIOR") // "JUNIOR" or "SENIOR"
  
  // Regional Settings
  country       String?
  currency      String?  @default("USD")
  
  // Onboarding extended fields
  title            String?
  language         String?
  credentials      String?
  sample           String?
  rate             Float?
  rushRate         String?
  availabilityType String?
  fastestTurn      String?
  aadharUrl        String?
  kycDone          Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Account {
  id String @id @default(uuid())
  userId            String  
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(uuid())
  sessionToken String   @unique
  userId       String   
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id String @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id String @id @default(uuid())
  title             String
  description       String?
  status            ProjectStatus @default(CREATED)
  deadline          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  studentId        String        
  student          User          @relation("StudentProjects", fields: [studentId], references: [id], onDelete: Cascade)
  
  freelancerId     String?       
  freelancer       User?         @relation("FreelancerProjects", fields: [freelancerId], references: [id])
  
  subAdminId       String?       
  subAdmin         User?         @relation("SubAdminProjects", fields: [subAdminId], references: [id])

  collaborators User[] @relation("CollaboratingProjects")

  serviceType       String?       // E.g. "SOP", "LOR", "RESUME"
  amount            Float?        @default(0)
  attachments       Json[]        // Array of {url, name}
  
  messages         Message[]
  orders           Order[]
  logs             ProjectLog[]
  freelancerInvoices FreelancerInvoice[]
  
  rating           Int?
  ratingComment    String?

  @@index([studentId])
  @@index([freelancerId])
  @@index([subAdminId])
  @@index([createdAt])
}

model Message {
  id String @id @default(uuid())
  content     String
  chatType    ChatType
  attachments Json[]   // Array of {url, name}
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  senderId    String   
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId  String?  
  receiver    User?    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  
  projectId   String?  
  project     Project? @relation(fields: [projectId], references: [id])

  chatId      String?  
  chat        Chat?    @relation(fields: [chatId], references: [id])

  @@index([projectId])
  @@index([createdAt])
}

model Notification {
  id String @id @default(uuid())
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  userId      String   
  user        User     @relation(fields: [userId], references: [id])
}

model Ticket {
  id String @id @default(uuid())
  type          String   // Order, Client, Writer
  subject       String
  description   String?  // Detailed issue description
  priority      String   @default("Medium") // High, Medium, Low
  status        String   @default("Open") // Open, In Progress, Resolved
  escalation    String   @default("None") // Level 1, Level 2, Level 3, None
  aiStatus      String?  // Draft sent, Monitoring, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  clientId      String?  
  client        User?    @relation("ClientTickets", fields: [clientId], references: [id])
  
  writerId      String?  
  writer        User?    @relation("WriterTickets", fields: [writerId], references: [id])
  
  orderId       String?  
  order         Order?   @relation(fields: [orderId], references: [id])
}

model Order {
  id String @id @default(uuid())
  amount        Float
  paymentStatus PaymentStatus @default(PENDING)
  razorpayId    String?       @unique
  cashfreeId    String?       @unique
  createdAt     DateTime      @default(now())

  // Relations
  projectId     String        
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  studentId     String        
  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  chat          Chat?
  tickets       Ticket[]
}

model ProjectLog {
  id String @id @default(uuid())
  action    String
  timestamp DateTime @default(now())

  // Relations
  projectId String   
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId    String   
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FreelancerInvoice {
  id String @id @default(uuid())
  amount          Float
  status          PaymentStatus  @default(PENDING)
  description     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  projectId       String         
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  freelancerId    String         
  freelancer      User           @relation("FreelancerInvoices", fields: [freelancerId], references: [id], onDelete: Cascade)
}

model PayoutRequest {
  id String @id @default(uuid())
  amount        Float
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  paymentMethod String?
  paymentDetails String? // UPI ID or Bank Details
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  freelancerId  String   
  freelancer    User     @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Chat {
  id String @id @default(uuid())
  orderId      String    @unique 
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  studentId    String    
  student      User      @relation("StudentChats", fields: [studentId], references: [id], onDelete: Cascade)
  
  freelancerId String?   
  freelancer   User?     @relation("FreelancerChats", fields: [freelancerId], references: [id])
  
  messages     Message[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
model Service {
  id String @id @default(uuid())
  slug          String   @unique
  name          String
  description   String
  features      String[]
  basePrice     Float
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Custom catalog fields
  tagline       String   @default("")
  category      String   @default("Academic")
  icon          String   @default("🎓")
  priceMin      Float    @default(0)
  priceMax      Float    @default(0)
  variantsCount Int      @default(1)
  addonsCount   Int      @default(0)
  ordersCount   Int      @default(0)
  revenue       String   @default("₹0")
}

model RefundRequest {
  id String @id @default(uuid())
  orderId       String   
  userId        String   
  amount        Float
  reason        String
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  priority      String   @default("MEDIUM")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PromoCode {
  id String @id @default(uuid())
  code          String   @unique
  type          String   // PERCENTAGE, FIXED
  value         Float
  minOrderValue Float    @default(0)
  usageLimit    Int?
  usageCount    Int      @default(0)
  expiryDate    DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model SystemConfig {
  id String @id @default(uuid())
  key           String   @unique // e.g. "SEO_SETTINGS", "MAINTENANCE_MODE"
  value         Json
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id String @id @default(uuid())
  userId        String?  
  userName      String?
  action        String
  details       String?
  ipAddress     String?
  createdAt     DateTime @default(now())
}

// ─── REVIEW & SLA SYSTEM ──────────────────────────────────────────────

// Student review submitted after project COMPLETED
model Review {
  id String @id @default(uuid())
  projectId       String   @unique 
  freelancerId    String   
  studentId       String   

  // Core rubric (each 1-5)
  qualityScore      Int   // Writing quality / accuracy
  communicationScore Int  // Responsiveness & clarity
  timelinessScore   Int   // Delivered on or before deadline
  requirementScore  Int   // Followed instructions / requirements
  overallScore      Int   // Overall satisfaction

  comment         String?
  createdAt       DateTime @default(now())
}

// SLA event log — one row per tracked milestone per project
model SLAEvent {
  id String @id @default(uuid())
  projectId       String   
  freelancerId    String   

  // Which milestone
  eventType       String
  // ASSIGN_ACCEPT   – writer started working after assignment
  // FIRST_REPLY     – first message sent by writer after assignment
  // DELIVERY        – file uploaded / status → REVIEW
  // REVISION_TURNAROUND – delivery after revision request

  occurredAt      DateTime @default(now())

  // Reference timestamps for calculation
  deadlineAt      DateTime?
  assignedAt      DateTime?
  firstMessageAt  DateTime?

  // Computed deltas (minutes)
  responseMinutes   Int?   // Time to first reply (lower=better, target ≤60)
  startMinutes      Int?   // Time to begin after assignment (target ≤120)
  deliveryOnTime    Boolean? // Was delivery before deadline?
  revisionMinutes   Int?   // Turnaround on revision (target ≤240)
}



model CheckoutSession {
  id String @id @default(uuid())
  services Json
  totalPrice Float
  status     String        @default("pending")
  createdBy  String
  userEmail  String?
  createdAt  DateTime      @default(now())

  payments   Payment[]     @relation("CheckoutSessionPayments")
}

model Payment {
  id String @id @default(uuid())
  userId            String   
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  razorpaySignature String?
  cashfreeOrderId   String?  @unique
  cashfreePaymentId String?
  cashfreeSignature String?
  amount            Float
  currency          String
  status            String   @default("created")
  planKey           String
  planName          String
  planDescription   String?
  checkoutSessionId String?  
  checkoutSession   CheckoutSession? @relation("CheckoutSessionPayments", fields: [checkoutSessionId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
